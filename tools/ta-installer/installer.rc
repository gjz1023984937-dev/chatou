// Chatou Installer — embedded resources.
//
// Integer IDs (see resource.h) — works around string-name FindResource issues.
// Paths are relative to this directory; _stage_embed.ps1 invokes rc.exe here.

#include "resource.h"

// UAC + DPI + UTF-8 manifest
1 24 "manifest.xml"

// Window / taskbar icon
1 ICON "..\\ta-settings\\chatou.ico"

// ───── Bundled binaries ─────────────────────────────────────────
IDR_RIME_DLL        RCDATA "embed\\rime.dll"
IDR_WEASELX64_DLL   RCDATA "embed\\weaselx64.dll"
IDR_WEASELSERVER    RCDATA "embed\\WeaselServer.exe"
IDR_WEASELDEPLOYER  RCDATA "embed\\WeaselDeployer.exe"
IDR_TA_SETTINGS     RCDATA "embed\\ta-settings.exe"
IDR_WV2_LOADER      RCDATA "embed\\WebView2Loader.dll"

// ───── ta-settings UI (gets copied to <install_dir>\ui\) ────────
IDR_TARGET_UI_HTML  RCDATA "embed\\target-ui\\index.html"
IDR_TARGET_UI_CSS   RCDATA "embed\\target-ui\\style.css"
IDR_TARGET_UI_JS    RCDATA "embed\\target-ui\\app.js"
IDR_TARGET_UI_PNG   RCDATA "embed\\target-ui\\chatou.png"

// ───── Schema yaml + supplement dict ────────────────────────────
IDR_SCHEMA_YAML     RCDATA "embed\\typeanything.schema.yaml"
IDR_DICT_YAML       RCDATA "embed\\typeanything.dict.yaml"

// ───── Installer's own UI ───────────────────────────────────────
IDR_INSTALL_HTML    RCDATA "embed\\install-ui\\index.html"
IDR_INSTALL_CSS     RCDATA "embed\\install-ui\\style.css"
IDR_INSTALL_JS      RCDATA "embed\\install-ui\\app.js"
IDR_INSTALL_PNG     RCDATA "embed\\install-ui\\chatou.png"

// ───── Rime base data (for cold-install) ────────────────────────
IDR_DATA_DEFAULT       RCDATA "embed\\default.yaml"
IDR_DATA_LUNA_DICT     RCDATA "embed\\luna_pinyin.dict.yaml"
IDR_DATA_LUNA_SCHEMA   RCDATA "embed\\luna_pinyin.schema.yaml"
IDR_DATA_ESSAY         RCDATA "embed\\essay.txt"
IDR_DATA_SYMBOLS       RCDATA "embed\\symbols.yaml"
IDR_DATA_PUNCTUATION   RCDATA "embed\\punctuation.yaml"
IDR_DATA_KEY_BINDINGS  RCDATA "embed\\key_bindings.yaml"
IDR_DATA_WEASEL_YAML   RCDATA "embed\\weasel.yaml"

// ───── Translate / classify prompts (UTF-8) ─────────────────────
IDR_PROMPTS_TXT        RCDATA "embed\\typeanything_prompts.txt"

// ───── OpenCC t2s data (繁→简 simplifier) ───────────────────────
IDR_OPENCC_T2S_JSON    RCDATA "embed\\opencc\\t2s.json"
IDR_OPENCC_TS_PHRASES  RCDATA "embed\\opencc\\TSPhrases.ocd2"
IDR_OPENCC_TS_CHARS    RCDATA "embed\\opencc\\TSCharacters.ocd2"
